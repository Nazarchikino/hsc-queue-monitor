# ==========================================
# ОСНОВНІ НАЛАШТУВАННЯ TELEGRAM
# ==========================================

# Токен вашого бота від @BotFather
BOT_TOKEN=your_bot_token_here

# Ваш числовий Telegram ID (можна отримати через @userinfobot)
CHAT_ID=123456789

# ==========================================
# ДАНІ ЕЛЕКТРОННОГО ПІДПИСУ (КЕП)
# ==========================================

# Назва або шлях до файлу ключа (має лежати в папці з ботом)
KEY_FILE_PATH=key.dat

# Пароль до вашого файлу КЕП
KEY_PASSWORD=your_kep_password

# Назва надавача КЕП у формі ID.GOV.UA
# Для ПриватБанку використовуйте: КНЕДП АЦСК АТ КБ "ПриватБанк"
# Для сервісу Вчасно використовуйте: КНЕДП ТОВ "Вчасно Сервіс"
CA_NAME_EXACT=КНЕДП АЦСК АТ КБ "ПриватБанк"

# ==========================================
# СТАРТОВІ ПАРАМЕТРИ МОНІТОРИНГУ
# ==========================================
DEFAULT_DEPT_ID=18    # ID сервісного центру (18 = Ковель)
DEFAULT_SERVICE_ID=52 # ID послуги (52 = Кат. C, 49 = Кат. B механіка)
